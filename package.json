{
  "name": "webdev-capabilities",
  "private": true,
  "type": "module",
  "description": "Framework for creating high-end websites with Claude Code: intake, build, localhost preview, offline export.",
  "scripts": {
    "setup": "node framework/tools/setup.mjs",
    "setup:quick": "node framework/tools/setup.mjs --quick",
    "new-site": "node framework/tools/new-site.mjs",
    "dev": "node framework/tools/site.mjs dev",
    "stop": "node framework/tools/site.mjs stop",
    "build": "node framework/tools/site.mjs build",
    "list": "node framework/tools/site.mjs list",
    "export": "node framework/tools/export-site.mjs",
    "weight": "node framework/tools/weight.mjs",
    "format": "prettier --config dev/config/prettierrc.json --ignore-path dev/config/prettierignore --write .",
    "format:check": "prettier --config dev/config/prettierrc.json --ignore-path dev/config/prettierignore --check .",
    "lint": "eslint --config dev/config/eslint.config.js .",
    "test": "node --test \"dev/tests/**/*.test.mjs\"",
    "check:docs": "node dev/scripts/check-docs.mjs",
    "smoke": "node dev/scripts/smoke.mjs",
    "smoke:examples": "node dev/scripts/smoke.mjs --examples",
    "check": "npm run format:check && npm run lint && npm run test && npm run check:docs",
    "status": "node framework/tools/status.mjs",
    "launch-prep": "node framework/tools/launch-prep.mjs",
    "launch-check": "node framework/tools/launch-check.mjs",
    "cms:check": "node framework/tools/cms-check.mjs",
    "dns-check": "node framework/tools/dns-check.mjs",
    "handover": "node framework/tools/handover.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9"
  }
}
