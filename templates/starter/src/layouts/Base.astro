---
import '../styles/global.css';
interface Props {
  title: string;
  description?: string;
  lang?: string;
}
const { title, description = '', lang = 'de' } = Astro.props;
// The canonical link needs the site address, which launch-prep writes into astro.config.mjs.
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : '';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <slot />
  </body>
</html>
