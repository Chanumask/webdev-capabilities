# ============================================================================
#  READ THIS FIRST
#
#  This is the ONLY place for passwords, API keys, tokens and other secrets.
#
#  1. Copy this file to a new file named ".env" (same folder, nothing else
#     changed in the name) and paste your values into the copy.
#  2. Never paste logins, passwords, API keys or tokens into the chat with the
#     AI agent, into any other file, an email, or a screenshot.
#  3. The AI agent is instructed never to open, read or print the ".env" file.
#     It only runs commands (for example "npm run cms:check") that read it
#     on your computer and report back "works" or "does not work", without
#     showing the values.
#  4. ".env" is excluded from git and from every export, so it is never
#     uploaded or sent along. This ".env.example" file contains no secrets
#     and is safe to share.
#  5. If a secret ever ends up somewhere it should not be, revoke it in the
#     service where you created it and make a new one.
# ============================================================================

# Where the content comes from: "files" (text in src/content, default)
# or "wix" (your Wix CMS).
CMS_PROVIDER=files

# --- Only needed when CMS_PROVIDER=wix ---------------------------------------
# Wix API key with the permission "Read Data Items" (Wix dashboard, Settings,
# API keys), the ID of your Wix site, and the IDs of the collections to load,
# separated by commas.
WIX_API_KEY=
WIX_SITE_ID=
WIX_COLLECTIONS=

# --- Later: other services (add as needed) -----------------------------------
# For example a deploy hook URL or a form service key. Add one line per value.
