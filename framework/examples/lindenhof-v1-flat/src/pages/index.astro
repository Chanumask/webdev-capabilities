---
import Base from '../layouts/Base.astro';
import { getSite, getListings } from '../content/provider';
import { isoHouseSvg } from '../lib/isoHouse';

const site = await getSite();
const listings = await getListings();
const eur = new Intl.NumberFormat('de-DE', { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 });
const themes = ['yellow', 'red', 'green', 'chalk', 'blue'];
const floorNames = ['Erdgeschoss', '1. Obergeschoss', '2. Obergeschoss', 'Dachgeschoss'];
const arrow = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square" aria-hidden="true"><path d="M3 12h17M14 5l7 7-7 7"/></svg>`;
---
<Base
  title="Lindenhof Hausverwaltung – Wohnungen und Häuser mieten, kaufen, verwalten"
  description="Demo-Website einer fiktiven Hausverwaltung: Mietobjekte, Kaufobjekte, Verwaltung für Eigentümer und Mieterservice."
>
  <header class="nav">
    <a class="plate brand" href="#top" aria-label={`${site.name}, zum Seitenanfang`}>
      <span class="brand-name">{site.name}</span>
      <span class="brand-sub">Hausverwaltung</span>
    </a>
    <nav class="plate menu" aria-label="Hauptnavigation">
      <button class="menu-toggle" aria-expanded="false" aria-controls="menu-list">Menü</button>
      <ul id="menu-list">
        <li><a href="#objekte" data-filter="mieten">Mieten</a></li>
        <li><a href="#objekte" data-filter="kaufen">Kaufen</a></li>
        <li><a href="#eigentuemer">Eigentümer</a></li>
        <li><a href="#mieter">Mieter</a></li>
        <li><a href="#kontakt">Kontakt</a></li>
      </ul>
    </nav>
  </header>

  <main>
    <section class="stage" id="top">
      <div class="stage-sticky" aria-hidden="true">
        <canvas id="scene"></canvas>
        {floorNames.map((n) => <span class="floor-tag plate">{n}</span>)}
      </div>

      <div class="chapters">
      <section class="chapter hero" data-theme="blue" aria-labelledby="h-hero">
        <div class="hero-copy">
          <h1 id="h-hero">Wohnen, das gut verwaltet ist.</h1>
          <p class="lede">{site.intro}</p>
          <form class="plate search" id="hero-search" aria-label="Objekte suchen">
            <fieldset class="seg-wrap">
              <legend class="sr-only">Mieten oder kaufen</legend>
              <div class="seg">
                <label><input type="radio" name="mode" value="mieten" checked /><span>Mieten</span></label>
                <label><input type="radio" name="mode" value="kaufen" /><span>Kaufen</span></label>
              </div>
            </fieldset>
            <label class="field"><span>Ort</span><input class="input" name="city" placeholder="Musterstadt" autocomplete="off" /></label>
            <label class="field"><span>Zimmer ab</span>
              <select class="input" name="rooms"><option value="0">egal</option><option value="1">1</option><option value="2">2</option><option value="3">3</option><option value="4">4+</option></select>
            </label>
            <button class="btn" type="submit">Objekte zeigen <Fragment set:html={arrow} /></button>
          </form>
        </div>
      </section>

      {site.chapters.map((c, i) => (
        <section class="chapter" data-theme={themes[i]} aria-labelledby={`h-${c.id}`}>
          <div class="copy">
            <h2 id={`h-${c.id}`}>{c.title}</h2>
            <p>{c.text}</p>
            <a class="btn" href={c.href} data-filter={c.filter}>{c.cta} <Fragment set:html={arrow} /></a>
          </div>
        </section>
      ))}
      </div>
    </section>

    <section class="listings" id="objekte" aria-labelledby="h-objekte">
      <div class="wrap">
        <div class="listings-head">
          <h2 id="h-objekte">Wohnungen und Häuser, gerade frei.</h2>
          <p class="note">Beispielobjekte mit Platzhalterdaten. Echte Angebote kommen später aus dem CMS.</p>
        </div>
        <form class="filters" id="filters" aria-label="Objekte filtern">
          <div class="seg">
            <label><input type="radio" name="mode" value="alle" checked /><span>Alle</span></label>
            <label><input type="radio" name="mode" value="mieten" /><span>Mieten</span></label>
            <label><input type="radio" name="mode" value="kaufen" /><span>Kaufen</span></label>
          </div>
          <label class="field"><span>Ort</span><input class="input" name="city" placeholder="Alle Orte" autocomplete="off" /></label>
          <label class="field"><span>Zimmer ab</span>
            <select class="input" name="rooms"><option value="0">egal</option><option value="1">1</option><option value="2">2</option><option value="3">3</option><option value="4">4+</option></select>
          </label>
          <p class="count" id="count" role="status" aria-live="polite"></p>
        </form>

        <ul class="rows" id="rows">
          {listings.map((l) => (
            <li class="row" data-mode={l.mode} data-city={l.city.toLowerCase()} data-rooms={l.rooms} data-accent={l.accent}
                data-address={`${l.street} ${l.number}, ${l.city}`}>
              <div class="ill" set:html={isoHouseSvg(l.floors, l.accent, l.kind, `${l.kind}, Zeichnung`)} />
              <div class="addr">
                <span class="hausnr" aria-hidden="true">{l.number}</span>
                <div>
                  <h3>{l.street} {l.number}</h3>
                  <p>{l.kind} zur {l.mode === 'mieten' ? 'Miete' : 'Kauf'} · {l.city}</p>
                </div>
              </div>
              <dl class="facts">
                <div><dt>Zimmer</dt><dd>{l.rooms}</dd></div>
                <div><dt>Fläche</dt><dd>{l.area} m²</dd></div>
                <div><dt>Frei</dt><dd>{l.available}</dd></div>
              </dl>
              <div class="price">
                <strong>{eur.format(l.price)}</strong>
                <span>{l.mode === 'mieten' ? 'Kaltmiete / Monat' : 'Kaufpreis'} · Beispiel</span>
                <a class="btn small" href="#kontakt" data-enquiry={`${l.kind} ${l.street} ${l.number}, ${l.city}`}>Anfragen <Fragment set:html={arrow} /></a>
              </div>
            </li>
          ))}
        </ul>
        <div class="empty" id="empty" hidden>
          <h3>Dazu haben wir gerade nichts.</h3>
          <p>Versuchen Sie einen anderen Ort oder weniger Zimmer.</p>
          <button class="btn" type="button" id="reset">Filter zurücksetzen</button>
        </div>
      </div>
    </section>

    <section class="owners" id="eigentuemer" aria-labelledby="h-owners">
      <div class="wrap owners-grid">
        <div class="owners-intro">
          <h2 id="h-owners">Sie besitzen. Wir kümmern uns.</h2>
          <p>Ob eine Wohnung oder ein ganzes Haus: Wir übernehmen die Verwaltung, damit Sie sich nicht um Abrechnung, Handwerker und Mieter kümmern müssen.</p>
          <a class="btn yellow" href="#kontakt" data-enquiry="Verwaltung anfragen" data-topic="verwalten">Verwaltung anfragen <Fragment set:html={arrow} /></a>
          <div class="owners-ill" set:html={isoHouseSvg(5, 'yellow', 'Wohnung', 'Mehrfamilienhaus, Zeichnung')} />
          <p class="poster" aria-hidden="true">Hausverwaltung</p>
        </div>
        <ul class="services">
          {site.services.map((s) => (
            <li>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="tenants" id="mieter" aria-labelledby="h-tenants">
      <div class="wrap tenants-grid">
        <div>
          <h2 id="h-tenants">Etwas kaputt? Sagen Sie es uns.</h2>
          <p>Beschreiben Sie kurz, was los ist. Wir kümmern uns darum und melden uns bei Ihnen.</p>
          <div class="emergency plate">
            <strong>Notfall außerhalb der Geschäftszeiten</strong>
            <a href={`tel:${site.emergencyPhone.replace(/\s/g, '')}`}>{site.emergencyPhone}</a>
            <span>Platzhalternummer</span>
          </div>
          <ul class="links">
            {site.tenantLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
          </ul>
          <div class="tenants-ill" set:html={isoHouseSvg(3, 'blue', 'Wohnung', 'Mehrfamilienhaus, Zeichnung')} />
        </div>
        <form class="plate form" id="damage-form" novalidate>
          <fieldset>
            <legend>Was ist betroffen?</legend>
            <div class="chips">
              {['Heizung', 'Wasser', 'Strom', 'Aufzug', 'Fenster und Türen', 'Sonstiges'].map((c, i) => (
                <label><input type="radio" name="category" value={c} checked={i === 0} /><span>{c}</span></label>
              ))}
            </div>
          </fieldset>
          <label class="field"><span>Adresse der Wohnung</span><input class="input" name="address" required placeholder="Straße, Hausnummer" autocomplete="street-address" /></label>
          <label class="field"><span>Was ist passiert?</span><textarea class="input" name="text" required placeholder="Zum Beispiel: Die Heizung im Wohnzimmer bleibt kalt."></textarea></label>
          <div class="two">
            <label class="field"><span>Ihr Name</span><input class="input" name="name" required placeholder=" " autocomplete="name" /></label>
            <label class="field"><span>Telefon oder E-Mail</span><input class="input" name="contact" required placeholder=" " autocomplete="email" /></label>
          </div>
          <label class="check"><input type="checkbox" name="urgent" /> <span>Dringend, es entstehen gerade Schäden.</span></label>
          <button class="btn" type="submit">Meldung senden <Fragment set:html={arrow} /></button>
          <p class="form-status" role="status" aria-live="polite" hidden></p>
        </form>
      </div>
    </section>

    <section class="contact" id="kontakt" aria-labelledby="h-contact">
      <div class="wrap contact-grid">
        <div>
          <h2 id="h-contact">Sprechen wir über Ihr Haus.</h2>
          <address>
            <p>{site.name} Hausverwaltung<br />{site.address.join(', ')}</p>
            <p><a href={`tel:${site.phone.replace(/\s/g, '')}`}>{site.phone}</a><br /><a href={`mailto:${site.email}`}>{site.email}</a></p>
          </address>
        </div>
        <form class="plate form" id="contact-form" novalidate>
          <fieldset>
            <legend>Worum geht es?</legend>
            <div class="chips">
              {[['mieten', 'Mieten'], ['kaufen', 'Kaufen'], ['verwalten', 'Verwalten lassen'], ['sonst', 'Etwas anderes']].map(([v, l], i) => (
                <label><input type="radio" name="topic" value={v} checked={i === 0} /><span>{l}</span></label>
              ))}
            </div>
          </fieldset>
          <label class="field"><span>Ihre Nachricht</span><textarea class="input" name="text" required placeholder="Wie können wir helfen?"></textarea></label>
          <div class="two">
            <label class="field"><span>Ihr Name</span><input class="input" name="name" required placeholder=" " autocomplete="name" /></label>
            <label class="field"><span>E-Mail</span><input class="input" type="email" name="contact" required placeholder=" " autocomplete="email" /></label>
          </div>
          <button class="btn" type="submit">Anfrage senden <Fragment set:html={arrow} /></button>
          <p class="form-status" role="status" aria-live="polite" hidden></p>
        </form>
      </div>
      <div class="wrap street" aria-hidden="true">
        {([[4, 'yellow', 'Wohnung'], [2, 'red', 'Haus'], [5, 'green', 'Wohnung'], [3, 'yellow', 'Wohnung'], [2, 'red', 'Haus'], [4, 'green', 'Wohnung']] as const).map(([f, a, k]) => <div set:html={isoHouseSvg(f, a, k, '')} />)}
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="wrap foot">
      <p class="foot-name">{site.name}</p>
      <p class="foot-note">Demo-Website mit fiktivem Unternehmen und Platzhalterinhalten. Impressum und Datenschutz folgen mit den echten Angaben des Kunden.</p>
      <ul><li><a href="#top">Impressum</a></li><li><a href="#top">Datenschutz</a></li><li><a href="#top">Nach oben</a></li></ul>
    </div>
  </footer>

  <script>
    import '../scripts/scene/scene';
    import '../scripts/ui';
  </script>
</Base>

<style is:global>
  /* ---------- nav ---------- */
  .nav { position: fixed; z-index: 50; inset: 14px var(--gutter) auto; display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; pointer-events: none; }
  .nav > * { pointer-events: auto; }
  .brand { display: grid; padding: 0.45rem 0.9rem 0.5rem; text-decoration: none; line-height: 1; }
  .brand-name { font-family: var(--font-display); font-weight: 700; font-size: 1.5rem; letter-spacing: -0.02em; }
  .brand-sub { font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; margin-top: 0.2rem; }
  .menu ul { list-style: none; margin: 0; padding: 0; display: flex; }
  .menu li + li { border-left: 2px solid var(--ink); }
  .menu a { display: block; padding: 0.8rem 1.1rem; font-family: var(--font-display); font-weight: 600; text-decoration: none; transition: background 0.2s, color 0.2s; }
  .menu a:hover { background: var(--ink); color: var(--chalk); }
  .menu-toggle { display: none; }
  @media (max-width: 760px) {
    .menu-toggle { display: block; background: none; border: 0; padding: 0.85rem 1.1rem; font-family: var(--font-display); font-weight: 600; cursor: pointer; }
    .menu { position: relative; }
    .menu ul { display: none; position: absolute; right: -2px; top: calc(100% + 6px); flex-direction: column; background: var(--chalk); border: 2px solid var(--ink); min-width: 12rem; }
    .menu li + li { border-left: 0; border-top: 2px solid var(--ink); }
    .menu[data-open="true"] ul { display: flex; }
  }

  /* ---------- stage: pinned 3D scene + chapters ---------- */
  .stage { position: relative; background: var(--bg, var(--blue)); color: var(--fg); }
  .stage-sticky { position: sticky; top: 0; height: 100svh; overflow: hidden; z-index: 0; pointer-events: none; }
  #scene { position: absolute; inset: 0; width: 100%; height: 100%; }
  .floor-tag { position: absolute; left: 0; top: 0; opacity: 0; margin: -0.9rem 0 0 3.5rem; padding: 0.35rem 0.8rem; font-family: var(--font-display); font-weight: 600; font-size: 1rem; white-space: nowrap; will-change: transform, opacity; }
  .floor-tag::before { content: ""; position: absolute; right: 100%; top: 50%; width: 3.5rem; height: 2px; background: var(--ink); }
  .chapters { position: relative; z-index: 1; margin-top: -100svh; }
  .chapter { position: relative; z-index: 1; min-height: 100svh; display: flex; align-items: center; padding: 6rem var(--gutter); color: var(--fg); }
  .chapter[data-theme="blue"] { --fg: var(--chalk); --btn-bg: var(--chalk); --btn-fg: var(--ink); --btn-border: var(--ink); --chapter-bg: var(--blue); }
  .chapter[data-theme="yellow"] { --fg: var(--ink); --btn-bg: var(--ink); --btn-fg: var(--yellow); --chapter-bg: var(--yellow); }
  .chapter[data-theme="red"] { --fg: var(--chalk); --btn-bg: var(--chalk); --btn-fg: var(--ink); --btn-border: var(--ink); --chapter-bg: var(--red); }
  .chapter[data-theme="green"] { --fg: var(--chalk); --btn-bg: var(--chalk); --btn-fg: var(--ink); --btn-border: var(--ink); --chapter-bg: var(--green); }
  .chapter[data-theme="chalk"] { --fg: var(--ink); --btn-bg: var(--ink); --btn-fg: var(--chalk); --chapter-bg: var(--chalk); }
  .no-webgl .chapter { background: var(--chapter-bg); }
  .no-webgl .stage-sticky { display: none; }
  .chapter.hero { min-height: 170svh; align-items: flex-start; padding-block: 0; }
  .hero-copy { min-height: 100svh; display: flex; flex-direction: column; justify-content: center; gap: 1.6rem; max-width: 36rem; padding-top: 5rem; }
  .hero-copy h1 { font-size: clamp(2.7rem, 6.4vw, 5.6rem); }
  .lede { font-size: 1.2rem; max-width: 34rem; }
  .copy { max-width: 31rem; display: grid; gap: 1.4rem; justify-items: start; }
  .copy h2 { font-size: clamp(2.4rem, 5vw, 4.6rem); }

  .search { display: grid; grid-template-columns: 1fr 1fr; gap: 0.9rem 0.8rem; padding: 1rem; align-items: end; }
  .search .seg-wrap { grid-column: 1 / -1; }
  .search .btn { grid-column: 1 / -1; justify-content: space-between; --btn-bg: var(--ink); --btn-fg: var(--chalk); }

  @media (max-width: 1000px) {
    .chapter { align-items: flex-end; padding-block: 3rem; }
    .chapter.hero { align-items: flex-start; }
    .hero-copy { justify-content: flex-end; padding-bottom: 1.2rem; gap: 1rem; }
    .hero-copy h1 { font-size: clamp(2.35rem, 6.5vw, 3.8rem); }
    .lede { font-size: 1rem; }
    .copy h2 { font-size: clamp(2.3rem, 6vw, 3.6rem); }
    .floor-tag { font-size: 0.82rem; margin: -2rem 0 0 0; }
    .floor-tag::before { display: none; }
    .listings .filters .field { flex: 1 1 40%; min-width: 0; }
  }

  /* ---------- listings ---------- */
  .wrap { width: min(100% - 2 * var(--gutter), 78rem); margin-inline: auto; }
  .listings { background: var(--chalk); padding: clamp(4rem, 9vw, 8rem) 0; }
  .listings-head { display: grid; gap: 0.8rem; margin-bottom: 2rem; }
  .listings-head h2 { font-size: clamp(2.4rem, 5.2vw, 4.8rem); max-width: 14ch; }
  .note { font-size: 0.95rem; max-width: none; border-top: 2px solid var(--ink); padding-top: 0.6rem; }
  .filters { display: flex; flex-wrap: wrap; gap: 1rem; align-items: end; margin-bottom: 1.5rem; }
  .filters .field { min-width: 11rem; }
  .count { margin-left: auto; font-family: var(--font-display); font-weight: 600; }
  .rows { list-style: none; margin: 0; padding: 0; border-top: 2px solid var(--ink); }
  .row { --c: var(--blue); --on: var(--chalk); display: grid; grid-template-columns: 10rem minmax(0, 1.3fr) minmax(0, 1fr) minmax(0, 0.9fr); gap: 1.5rem; align-items: center; padding: 1.1rem 1rem; border-bottom: 2px solid var(--ink); transition: background 0.3s var(--ease), color 0.3s; }
  .row[hidden] { display: none; }
  .row[data-accent="red"] { --c: var(--red); } .row[data-accent="green"] { --c: var(--green); } .row[data-accent="yellow"] { --c: var(--yellow); --on: var(--ink); }
  .row:hover, .row:focus-within { background: var(--c); color: var(--on); }
  .row:hover .btn, .row:focus-within .btn { --btn-bg: var(--on); --btn-fg: var(--c); --btn-border: var(--on); }
  .ill svg { width: 100%; height: auto; max-height: 7rem; }
  .addr { display: flex; align-items: center; gap: 1rem; }
  .hausnr { flex: none; display: grid; place-items: center; min-width: 3.4rem; height: 3.4rem; padding: 0 0.4rem; background: var(--blue); color: var(--chalk); font-family: var(--font-display); font-weight: 600; font-size: 1.7rem; outline: 2px solid var(--chalk); outline-offset: -6px; border: 2px solid var(--ink); }
  .addr h3 { font-size: 1.8rem; letter-spacing: -0.02em; }
  .addr p { font-size: 1rem; }
  .facts { display: flex; gap: 1.6rem; margin: 0; }
  .facts dt { font-size: 0.8rem; letter-spacing: 0.08em; text-transform: uppercase; opacity: 0.8; }
  .facts dd { margin: 0; font-family: var(--font-display); font-weight: 600; font-size: 1.3rem; font-variant-numeric: tabular-nums; }
  .price { display: grid; gap: 0.2rem; justify-items: start; }
  .price strong { font-family: var(--font-display); font-size: 2rem; font-weight: 600; letter-spacing: -0.02em; font-variant-numeric: tabular-nums; }
  .price span { font-size: 0.85rem; opacity: 0.85; }
  .btn.small { padding: 0.5rem 0.9rem; min-height: 2.5rem; font-size: 1rem; margin-top: 0.5rem; }
  .empty { padding: 3rem 0; display: grid; gap: 1rem; justify-items: start; }
  .empty h3 { font-size: 2.2rem; }
  @media (max-width: 980px) {
    .row { grid-template-columns: 7rem 1fr; }
    .facts, .price { grid-column: 2; }
    .ill { grid-row: span 3; }
  }
  @media (max-width: 560px) {
    .row { grid-template-columns: 1fr; }
    .facts, .price, .ill { grid-column: 1; grid-row: auto; }
    .ill { width: 8rem; }
    .addr h3 { font-size: 1.5rem; }
    .count { margin-left: 0; width: 100%; }
  }

  /* ---------- owners ---------- */
  .owners { background: var(--ink); color: var(--chalk); padding: clamp(4rem, 9vw, 8rem) 0; --btn-bg: var(--yellow); --btn-fg: var(--ink); --btn-border: var(--yellow); }
  .owners-grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: clamp(2rem, 6vw, 6rem); align-items: start; }
  .owners-intro { display: grid; gap: 1.4rem; justify-items: start; }
  .owners h2 { font-size: clamp(2.4rem, 5vw, 4.6rem); }
  .owners-ill { width: min(100%, 26rem); margin-top: 1.5rem; }
  .poster { font-family: var(--font-display); font-weight: 700; font-size: clamp(2.6rem, 6.2vw, 6rem); letter-spacing: -0.02em; line-height: 0.9; color: var(--yellow); margin-top: 1rem; max-width: none; }
  .services { list-style: none; margin: 0; padding: 0; border-top: 2px solid rgb(236 238 239 / 0.35); }
  .services li { padding: 1.4rem 1rem; border-bottom: 2px solid rgb(236 238 239 / 0.35); transition: background 0.3s var(--ease), color 0.3s; }
  .services li > * { transition: transform 0.4s var(--ease); }
  .services li:hover { background: var(--yellow); color: var(--ink); }
  .services li:hover > * { transform: translateX(0.8rem); }
  .services h3 { font-size: clamp(1.7rem, 3vw, 2.5rem); margin-bottom: 0.3rem; }
  @media (max-width: 860px) { .owners-grid { grid-template-columns: 1fr; } }

  /* ---------- tenants ---------- */
  .tenants { background: var(--yellow); padding: clamp(4rem, 9vw, 8rem) 0; }
  .tenants-grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: clamp(2rem, 6vw, 6rem); align-items: start; }
  .tenants h2 { font-size: clamp(2.4rem, 5vw, 4.6rem); margin-bottom: 1.2rem; }
  .emergency { margin-top: 2rem; padding: 1rem 1.2rem; display: grid; gap: 0.2rem; max-width: 24rem; box-shadow: none; }
  .emergency a { font-family: var(--font-display); font-weight: 600; font-size: 1.8rem; text-decoration: none; }
  .emergency span { font-size: 0.85rem; }
  .tenants-ill { width: min(100%, 22rem); margin-top: 2.5rem; }
  .links { list-style: none; padding: 0; margin: 1.5rem 0 0; display: grid; gap: 0.4rem; }
  @media (max-width: 860px) { .tenants-grid { grid-template-columns: 1fr; } }

  /* ---------- forms ---------- */
  .form { display: grid; gap: 1.1rem; padding: clamp(1rem, 3vw, 1.8rem); }
