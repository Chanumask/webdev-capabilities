#!/bin/sh
# Pre-commit guard. Fast on purpose.
#   0. Blocks commits on main unless WEBDEV_ALLOW_MAIN=1 (only the squash-merge step sets it, decision 0002).
#   1. Blocks commits that delete tracked files unless WEBDEV_ALLOW_DELETE=1 (decision 0004).
#   2. Blocks files that should never be committed (env files, keys, customer sites, exports).
#   3. Blocks staged additions that look like secrets (the hooks folder itself is exempt).
#   4. Blocks new files over 1 MB.
#   5. Runs the docs check when docs are staged, Prettier and ESLint on staged scripts.
# Bypass (not a reflex): git commit --no-verify

fail=0

# 0. No direct commits on main
branch=$(git symbolic-ref --short -q HEAD)
if [ "$branch" = "main" ] && [ "$WEBDEV_ALLOW_MAIN" != "1" ]; then
  printf >&2 '%s\n' "pre-commit: no direct commits on main. Work on a feature branch: git switch -c <type>/<topic>" \
    "Only the local squash-merge step of the feature workflow sets WEBDEV_ALLOW_MAIN=1 (decision 0002)."
  exit 1
fi

# 1. Deletions of tracked files need explicit user approval
deleted=$(git diff --cached --name-only --diff-filter=D)
if [ -n "$deleted" ] && [ "$WEBDEV_ALLOW_DELETE" != "1" ]; then
  printf >&2 '%s\n' "pre-commit: this commit deletes tracked files. Ask the user first, naming them:"
  printf >&2 '  %s\n' $deleted
  printf >&2 '%s\n' "After explicit approval, set WEBDEV_ALLOW_DELETE=1 for that one commit (decision 0004)."
  exit 1
fi

staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$staged" ] && exit 0

# 2. Forbidden paths
bad=$(printf '%s\n' "$staged" | grep -E '(^|/)\.env($|\.)|\.pem$|\.key$|^sites/[^/]+/|^exports/|^\.smoke/|\.framework-state\.json$' | grep -v -E '\.env\.example$|^sites/README\.md$')
if [ -n "$bad" ]; then
  printf >&2 '%s\n' "pre-commit: these paths must not be committed (secrets, customer sites, generated output):"
  printf >&2 '  %s\n' $bad
  fail=1
fi

# 3. Secret-looking additions
hits=$(git diff --cached -U0 --diff-filter=ACM -- . ':!.githooks' | grep -E '^\+' | grep -E \
  -e 'sk-ant-[A-Za-z0-9_-]{20,}' \
  -e 'AKIA[0-9A-Z]{16}' \
  -e 'gh[pousr]_[A-Za-z0-9]{30,}' \
  -e '-----BEGIN (RSA |OPENSSH |EC |DSA )?PRIVATE KEY-----' \
  -e '(api[_-]?key|secret|token|password)[[:space:]]*[:=][[:space:]]*["'"'"'][A-Za-z0-9_./+-]{24,}["'"'"']')
if [ -n "$hits" ]; then
  printf >&2 '%s\n' "pre-commit: staged changes look like they contain a secret:"
  printf '%s\n' "$hits" | cut -c1-100 | sed 's/^/  /' >&2
  fail=1
fi

# 4. New large files
for f in $(git diff --cached --name-only --diff-filter=A); do
  size=$(git cat-file -s ":$f" 2>/dev/null || echo 0)
  if [ "$size" -gt 1048576 ]; then
    printf >&2 '%s\n' "pre-commit: $f is $size bytes (limit 1048576)."
    fail=1
  fi
done

# 5. Docs check, format and lint of staged scripts
if printf '%s\n' "$staged" | grep -Eq '^(docs/|CLAUDE\.md|README\.md|\.claude/skills/|framework/|capabilities/)'; then
  if command -v node >/dev/null 2>&1; then
    node scripts/check-docs.mjs || fail=1
  fi
fi
code=$(printf '%s\n' "$staged" | grep -E '^(tools|scripts|tests)/.*\.mjs$|^eslint\.config\.js$')
if [ -n "$code" ] && [ -d node_modules ]; then
  npx --no-install prettier --check $code || fail=1
  npx --no-install eslint $code || fail=1
fi

exit $fail
